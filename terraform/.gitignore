# Local .terraform directories
**/.terraform/*

# .tfstate files (contain sensitive data + resource IDs)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude variable files that may have sensitive data
*.tfvars
*.tfvars.json

# Ignore override files (usually local overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files if using multiple platforms (optional — many teams DO commit this)
# .terraform.lock.hcl